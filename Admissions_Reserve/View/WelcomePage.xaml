<Page x:Class="Admissions_Reserve.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WelcomePage">

    <Grid>
        <TextBlock Text="Добро пожаловать" FontSize="28" FontWeight="Bold" Margin="30,30,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <TextBlock Text="Резервное приложение для приемной комиссии" FontSize="16" Margin="32,80,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <StackPanel Margin="30,150,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Button x:Name="BtnLogin" Content="Войти" Width="200" Height="40" Margin="0,0,0,10"
                    Background="#007ACC" Foreground="White" FontSize="12" FontWeight="Bold" Click="BtnLogin_Click"/>
            <Button x:Name="BtnConnectDb" Content="Подключить базу данных" Width="200" Height="40" Margin="0,0,0,10"
                    Background="#FF9800" Foreground="White" FontSize="12" Click="BtnConnectDb_Click"/>
            <Button x:Name="BtnExit" Content="Выход" Width="200" Height="40"
                    Background="#F0F0F0" FontSize="12" Click="BtnExit_Click"/>
        </StackPanel>

        <!-- Индикатор статуса подключения БД -->
        <Border Background="#F0F0F0" CornerRadius="5" Padding="10" Margin="30,300,30,0" 
                VerticalAlignment="Top" HorizontalAlignment="Left" Width="300">
            <StackPanel>
                <TextBlock Text="Статус базы данных:" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="DbStatusText" Text="Не подключена" FontSize="11" 
                           Foreground="Red" Margin="0,5,0,0"/>
                <TextBlock x:Name="DbPathText" Text="" FontSize="10" Foreground="Gray" 
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>