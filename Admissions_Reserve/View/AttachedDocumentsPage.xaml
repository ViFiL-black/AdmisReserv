<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="Admissions_Reserve.View.AttachedDocumentsPage"
    Title="Приложенные документы">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="15">

                <TextBlock Text="Основные документы, приложенные к заявлению" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <!-- Таблица всех документов -->
                <TextBlock Text="Список документов" FontSize="13" FontWeight="Bold" Background="#E8EFF7" Padding="8" Margin="0,0,0,8"/>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,15" CornerRadius="5">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <DataGrid x:Name="DocumentsGrid" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" FontSize="11" BorderThickness="0"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Width="40" Binding="{Binding Number}" />
                                <DataGridTextColumn Header="Тип документа" Width="180" Binding="{Binding DocumentType}" />
                                <DataGridTextColumn Header="Серия и номер" Width="130" Binding="{Binding SeriesNumber}" />
                                <DataGridTextColumn Header="Категория" Width="140" Binding="{Binding Category}" />
                                <DataGridTextColumn Header="Дата выдачи" Width="100" Binding="{Binding IssueDate, StringFormat='dd.MM.yyyy'}" />
                                <DataGridTextColumn Header="Информация о документе" Width="250" Binding="{Binding DocumentInfo}" />
                                <DataGridTemplateColumn Header="Удалить" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✖" FontSize="10" Width="25" Height="20"
                                                    Background="#FF5722" Foreground="White"
                                                    Click="DeleteDocument_Click" Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Border>

                <!-- Кнопки навигации -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                    <Button x:Name="PrevButton" Content="Назад" Click="PrevButton_Click" Width="90" Height="32" Margin="0,0,10,0" FontSize="11" Background="#F0F0F0"/>
                    <Button x:Name="CompleteButton" Content="Завершить" Click="CompleteButton_Click" Width="120" Height="32" Margin="0,0,10,0" FontSize="11" Background="#4CAF50" Foreground="White"/>
                    <Button x:Name="CancelButton" Content="Отменить" Click="CancelButton_Click" Width="90" Height="32" FontSize="11" Background="#F0F0F0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>