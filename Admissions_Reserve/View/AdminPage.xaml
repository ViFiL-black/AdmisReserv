<Page x:Class="Admissions_Reserve.View.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Панель администратора">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="15">

                <TextBlock Text="Панель администратора" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <TabControl>
                    <!-- Вкладка: Пользователи -->
                    <TabItem Header="Пользователи">
                        <StackPanel Margin="0,10,0,0">

                            <!-- БЛОК ДОБАВЛЕНИЯ НОВОГО ПОЛЬЗОВАТЕЛЯ -->
                            <TextBlock Text="Добавление нового пользователя" FontSize="13" FontWeight="Bold" 
                                       Background="#E8EFF7" Padding="8" Margin="0,0,0,8"/>

                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,15" 
                                    Padding="10" Background="#FAFAFA">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Логин" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="*" Foreground="Red" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBox x:Name="LoginTextBox" Height="23" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Пароль" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="*" Foreground="Red" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <PasswordBox x:Name="PasswordBox" Height="23" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Роль" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="*" Foreground="Red" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <ComboBox x:Name="RoleCombo" Height="23" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ФИО (полностью)" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="*" Foreground="Red" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBox x:Name="FullNameTextBox" Height="23" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button x:Name="AddUserButton" Content="Добавить пользователя" 
                                                Click="AddUserButton_Click" Width="140" Height="28" 
                                                Margin="0,0,8,0" FontSize="11" Background="#007ACC" Foreground="White"/>
                                        <Button x:Name="ClearButton" Content="Очистить поля" 
                                                Click="ClearButton_Click" Width="100" Height="28" 
                                                FontSize="11" Background="#F0F0F0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- СПИСОК ПОЛЬЗОВАТЕЛЕЙ -->
                            <TextBlock Text="Список пользователей" FontSize="13" FontWeight="Bold" 
                                       Background="#E8EFF7" Padding="8" Margin="0,0,0,8"/>

                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,15" 
                                    Padding="5" Background="White">
                                <DataGrid x:Name="UsersDataGrid" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          RowHeight="30" FontSize="11" Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                                        <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="100"/>
                                        <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" Width="120"/>
                                        <DataGridTemplateColumn Header="Действие" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Удалить" Tag="{Binding}" Click="DeleteUserButton_Click" 
                                                            Width="60" Height="22" FontSize="10" Background="#E81123" Foreground="White"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <TextBlock x:Name="StatusTextBlock" FontSize="11" Foreground="Gray" 
                                       TextWrapping="Wrap" Margin="0,0,0,15" Text=""/>
                        </StackPanel>
                    </TabItem>

                    <!-- Вкладка: Конкурсы -->
                    <TabItem Header="Конкурсы">
                        <StackPanel Margin="0,10,0,0">

                            <!-- Форма добавления/редактирования конкурса -->
                            <TextBlock Text="Добавление / редактирование конкурса" FontSize="13" FontWeight="Bold" 
                                       Background="#E8EFF7" Padding="8" Margin="0,0,0,8"/>

                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,15" 
                                    Padding="10" Background="#FAFAFA">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Название конкурса" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="*" Foreground="Red" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBox x:Name="CompetitionNameTextBox" Height="23" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Базовое образование" FontSize="11" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="CompetitionBaseCombo" Height="23" FontSize="11" 
                                                      DisplayMemberPath="Name" SelectedValuePath="Name"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Форма обучения" FontSize="11" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="CompetitionFormCombo" Height="23" FontSize="11" 
                                                      DisplayMemberPath="Name" SelectedValuePath="Name"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Вид приема" FontSize="11" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="CompetitionAdmissionTypeCombo" Height="23" FontSize="11" 
                                                      DisplayMemberPath="Name" SelectedValuePath="Name"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Отделение" FontSize="11" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="CompetitionDepartmentCombo" Height="23" FontSize="11" 
                                                      DisplayMemberPath="Name" SelectedValuePath="Name"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Филиал" FontSize="11" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="CompetitionBranchCombo" Height="23" FontSize="11" 
                                                      DisplayMemberPath="Name" SelectedValuePath="Name"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="CompetitionIsActiveCheckBox" Content="Активен" FontSize="11" IsChecked="True" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button x:Name="AddCompetitionButton" Content="Добавить" 
                                                Click="AddCompetitionButton_Click" Width="100" Height="28" 
                                                Margin="0,0,8,0" FontSize="11" Background="#007ACC" Foreground="White"/>
                                        <Button x:Name="UpdateCompetitionButton" Content="Обновить" 
                                                Click="UpdateCompetitionButton_Click" Width="100" Height="28" 
                                                Margin="0,0,8,0" FontSize="11" Background="#FF9800" Foreground="White" IsEnabled="False"/>
                                        <Button x:Name="CancelCompetitionButton" Content="Отменить" 
                                                Click="CancelCompetitionButton_Click" Width="100" Height="28" 
                                                FontSize="11" Background="#F0F0F0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- СПИСОК КОНКУРСОВ -->
                            <TextBlock Text="Список конкурсов" FontSize="13" FontWeight="Bold" 
                                       Background="#E8EFF7" Padding="8" Margin="0,0,0,8"/>

                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,15" 
                                    Padding="5" Background="White">
                                <DataGrid x:Name="CompetitionsDataGrid" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          RowHeight="30" FontSize="11" Margin="0,0,0,8"
                                          SelectionChanged="CompetitionsDataGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="База" Binding="{Binding EducationBase}" Width="*"/>
                                        <DataGridTextColumn Header="Форма" Binding="{Binding StudyForm}" Width="*"/>
                                        <DataGridTextColumn Header="Вид приема" Binding="{Binding AdmissionType}" Width="*"/>
                                        <DataGridTextColumn Header="Отделение" Binding="{Binding Department}" Width="*"/>
                                        <DataGridTextColumn Header="Филиал" Binding="{Binding Branch}" Width="*"/>
                                        <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="60">
                                            <DataGridCheckBoxColumn.ElementStyle>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridCheckBoxColumn.ElementStyle>
                                        </DataGridCheckBoxColumn>
                                        <DataGridTemplateColumn Header="Действия" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="✎" Tag="{Binding}" Click="EditCompetitionButton_Click" 
                                                                Width="25" Height="22" FontSize="10" Background="#2196F3" Foreground="White" Margin="0,0,5,0"/>
                                                        <Button Content="✖" Tag="{Binding}" Click="DeleteCompetitionButton_Click" 
                                                                Width="25" Height="22" FontSize="10" Background="#E81123" Foreground="White"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <TextBlock x:Name="CompetitionStatusTextBlock" FontSize="11" Foreground="Gray" 
                                       TextWrapping="Wrap" Margin="0,0,0,15" Text=""/>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- КНОПКИ НАВИГАЦИИ (общие) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10">
                    <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click" 
                            Width="90" Height="32" Margin="0,0,10,0" FontSize="11" Background="#F0F0F0"/>
                    <Button x:Name="CreateDbButton" Content="Создать БД" Click="CreateDbButton_Click" 
                            Width="90" Height="32" Margin="0,0,10,0" FontSize="11" Background="#4CAF50" Foreground="White"/>
                    <Button x:Name="ConnectDbButton" Content="Подключить БД" Click="ConnectDbButton_Click" 
                            Width="100" Height="32" Margin="0,0,10,0" FontSize="11" Background="#FF9800" Foreground="White"/>
                    <Button x:Name="ExitButton" Content="Выйти" Click="ExitButton_Click" 
                            Width="90" Height="32" FontSize="11" Background="#F0F0F0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>