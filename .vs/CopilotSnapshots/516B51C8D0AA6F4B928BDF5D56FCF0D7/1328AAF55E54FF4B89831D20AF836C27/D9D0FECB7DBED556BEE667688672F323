<Window x:Class="Admissions_Reserve.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Admissions_Reserve"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Навигационное меню (скрыто по умолчанию) -->
        <StackPanel x:Name="NavigationMenu" 
                    Orientation="Horizontal" 
                    Background="#F5F7FA" 
                    Margin="0,0,0,5"
                    Visibility="Collapsed"
                    Grid.Row="0">
            <TextBlock Text="Шаги: " FontWeight="Bold" Margin="8,0,4,0" VerticalAlignment="Center"/>
            <Button Content="Удостоверение личности" Click="NavigationMenu_StepClick" Tag="IdentityPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="Контакты" Click="NavigationMenu_StepClick" Tag="ContactsPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="Вид заявления и образование" Click="NavigationMenu_StepClick" Tag="ApplicationTypeAndEducationPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="Документы" Click="NavigationMenu_StepClick" Tag="DocumentsPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="Родственники" Click="NavigationMenu_StepClick" Tag="RelativesPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="Доп. сведения" Click="NavigationMenu_StepClick" Tag="AdditionalInfoPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="Заявление, выбор конкурсов" Click="NavigationMenu_StepClick" Tag="ApplicationCompetitionsPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="Инд. достижения" Click="NavigationMenu_StepClick" Tag="IndividualAchievementsPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="Приоритеты" Click="NavigationMenu_StepClick" Tag="PrioritiesPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="Приложенные документы" Click="NavigationMenu_StepClick" Tag="AttachedDocumentsPage" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
        </StackPanel>
        
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Grid.Row="1"></Frame>
    </Grid>
</Window>
